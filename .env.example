# Gateway
PORT=3000
GATEWAY_PORT=3000
DASHBOARD_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
PUBLIC_APP_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:3000
PRODUCT_NAME=ZapBot
VITE_PRODUCT_NAME=ZapBot

# Security
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=8h
SERVICE_TOKEN=replace-with-a-long-random-service-token
DEFAULT_ORG_ID=1
RATE_LIMIT_PER_MINUTE=300
ADMIN_NAME=
ADMIN_EMAIL=admin@example.local
ADMIN_PASSWORD=replace-with-local-admin-password

# Database
# Banco oficial da plataforma: Supabase/PostgreSQL.
# Em producao, preencha DATABASE_URL e deixe SQLITE_PATH apenas para desenvolvimento local.
# Example Supabase URI:
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-us-east-1.pooler.supabase.com:6543/postgres
DATABASE_URL=
SUPABASE_DATABASE_URL=
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=false
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_SYNC_ALTER=false

# Local fallback only. Used when DATABASE_URL is empty.
SQLITE_PATH=./data/platform.sqlite
DEFAULT_WORKSPACE_NAME=
DEFAULT_WORKSPACE_SLUG=default
DEFAULT_WORKSPACE_ID=1

# Service ports
AUTH_PORT=3001
CRM_PORT=3002
AUTOMATION_PORT=3003
MESSAGING_PORT=3004
AI_PORT=3005
BILLING_PORT=3006
TEAM_PORT=3007
LIVECHAT_PORT=3008
BROADCASTS_PORT=3009
INTEGRATIONS_PORT=3010
PUBLIC_API_PORT=3011

# Service URLs used by gateway and internal HTTP calls
AUTH_SERVICE_URL=http://localhost:3001
CRM_SERVICE_URL=http://localhost:3002
AUTOMATION_SERVICE_URL=http://localhost:3003
MESSAGING_SERVICE_URL=http://localhost:3004
AI_SERVICE_URL=http://localhost:3005
BILLING_SERVICE_URL=http://localhost:3006
TEAM_SERVICE_URL=http://localhost:3007
LIVECHAT_SERVICE_URL=http://localhost:3008
BROADCASTS_SERVICE_URL=http://localhost:3009
INTEGRATIONS_SERVICE_URL=http://localhost:3010
PUBLIC_API_SERVICE_URL=http://localhost:3011

# Per-service SQLite databases for local/dev deployment
AUTH_DATABASE_URL=sqlite:./data/auth.sqlite
CRM_DATABASE_URL=sqlite:./data/crm.sqlite
AUTOMATION_DATABASE_URL=sqlite:./data/automation.sqlite
MESSAGING_DATABASE_URL=sqlite:./data/messaging.sqlite
AI_DATABASE_URL=sqlite:./data/ai.sqlite
BILLING_DATABASE_URL=sqlite:./data/billing.sqlite
TEAM_DATABASE_URL=sqlite:./data/team.sqlite
LIVECHAT_DATABASE_URL=sqlite:./data/livechat.sqlite
BROADCASTS_DATABASE_URL=sqlite:./data/broadcasts.sqlite
INTEGRATIONS_DATABASE_URL=sqlite:./data/integrations.sqlite

# WhatsApp Cloud API
WHATSAPP_VERIFY_TOKEN=replace-with-your-webhook-verify-token
WHATSAPP_API_TOKEN=replace-with-your-whatsapp-cloud-api-token
WHATSAPP_PHONE_NUMBER_ID=replace-with-your-phone-number-id
WHATSAPP_API_VERSION=v20.0
WHATSAPP_GRAPH_VERSION=v20.0
WHATSAPP_DRY_RUN=true

# Multi-LLM AI providers
DEFAULT_AI_PROVIDER=gpt
DEFAULT_AI_MODEL=gpt-4o-mini
FALLBACK_AI_PROVIDER=claude
FALLBACK_AI_MODEL=claude-3-5-haiku-latest
AI_PROVIDER_TIMEOUT_MS=30000

# GPT / OpenAI
OPENAI_API_KEY=replace-with-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TEMPERATURE=0.4
OPENAI_TIMEOUT_MS=30000
OPENAI_AUTO_REPLY=true
OPENAI_MODERATION_ENABLED=false
OPENAI_MODERATION_MODEL=omni-moderation-latest

# OpenRouter - recomendado para escolha de múltiplos modelos por agente
DEFAULT_LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=replace-with-your-openrouter-api-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DEFAULT_MODEL=openai/gpt-4o-mini
OPENROUTER_APP_NAME=${PRODUCT_NAME}
OPENROUTER_TIMEOUT_MS=30000
OPENROUTER_REQUIRE_KEY_FOR_MODELS=false

# Optional RAG scaffold
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=zapbot_documents

# Local schedulers
SEQUENCE_CRON=* * * * *
SEQUENCE_BATCH_SIZE=50
BROADCAST_CRON=*/10 * * * * *
BROADCAST_BATCH_SIZE=25
DISABLE_CRON=false

# Claude / Anthropic
ANTHROPIC_API_KEY=replace-with-your-anthropic-api-key
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_VERSION=2023-06-01
CLAUDE_MODEL=claude-3-5-haiku-latest
CLAUDE_MAX_TOKENS=700

# Gemini / Google
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-2.5-flash

# Grok / xAI
XAI_API_KEY=replace-with-your-xai-api-key
XAI_BASE_URL=https://api.x.ai/v1
GROK_MODEL=grok-4

# Billing
PAYMENT_PROVIDER=mock
PAYMENT_GATEWAY_URL=
PAYMENT_GATEWAY_API_KEY=

# Public API for external systems connecting to this platform
API_INTEGRATION_KEY=dev-api-key

# External REST/GraphQL integration layer
CRM_BASE_URL=
CRM_API_KEY=
CRM_TIMEOUT_MS=10000
INTEGRATION_TIMEOUT_MS=15000

# MCP server for third-party AI clients
MCP_BACKEND=mock
MCP_TRANSPORT=stdio
MCP_MOCK_DATA_PATH=
MCP_CONNECTOR_TIMEOUT_MS=20000
ZAPBOT_API_BASE_URL=http://localhost:3000
ZAPBOT_API_TOKEN=replace-with-service-token-or-jwt
ZAPBOT_API_TIMEOUT_SECONDS=20
