{
  "name": "zapbot-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Microservice backend for the ZapBot platform.",
  "main": "services/gateway/index.js",
  "scripts": {
    "start": "node services/gateway/index.js",
    "dev": "concurrently -n gateway,auth,crm,automation,messaging,ai,billing,team,livechat,broadcasts,integrations,public-api -c cyan,green,blue,magenta,yellow,white,red,gray,cyan,blue,magenta,yellow \"npm run dev:gateway\" \"npm run dev:auth\" \"npm run dev:crm\" \"npm run dev:automation\" \"npm run dev:messaging\" \"npm run dev:ai\" \"npm run dev:billing\" \"npm run dev:team\" \"npm run dev:livechat\" \"npm run dev:broadcasts\" \"npm run dev:integrations\" \"npm run dev:public-api\"",
    "dev:gateway": "nodemon services/gateway/index.js",
    "dev:auth": "nodemon services/auth/index.js",
    "dev:crm": "nodemon services/crm/index.js",
    "dev:automation": "nodemon services/automation/index.js",
    "dev:messaging": "nodemon services/messaging/index.js",
    "dev:ai": "nodemon services/ai/index.js",
    "dev:billing": "nodemon services/billing/index.js",
    "dev:team": "nodemon services/team/index.js",
    "dev:livechat": "nodemon services/livechat/index.js",
    "dev:broadcasts": "nodemon services/broadcasts/index.js",
    "dev:integrations": "nodemon services/integrations/index.js",
    "dev:public-api": "nodemon services/public-api/index.js",
    "start:gateway": "node services/gateway/index.js",
    "start:auth": "node services/auth/index.js",
    "start:crm": "node services/crm/index.js",
    "start:automation": "node services/automation/index.js",
    "start:messaging": "node services/messaging/index.js",
    "start:ai": "node services/ai/index.js",
    "start:billing": "node services/billing/index.js",
    "start:team": "node services/team/index.js",
    "start:livechat": "node services/livechat/index.js",
    "start:broadcasts": "node services/broadcasts/index.js",
    "start:integrations": "node services/integrations/index.js",
    "start:public-api": "node services/public-api/index.js",
    "test": "npm run test:syntax && npm run test:unit && npm run test:integration",
    "test:syntax": "node tests/syntax-check.js",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:integration": "node --test --test-timeout=120000 tests/integration/*.test.js"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "bcryptjs": "^2.4.3",
    "concurrently": "^9.1.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "http-proxy-middleware": "^3.0.3",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "sequelize": "^6.37.5",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  }
}
